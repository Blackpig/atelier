{
  "name": "blackpig-creatif/atelier",
  "description": "L'art du contenu - Artisanal content blocks for FilamentPHP v5",
  "keywords": [
    "laravel",
    "filament",
    "filamentphp",
    "cms",
    "blocks",
    "content-management",
    "page-builder",
    "blackpig-creatif",
    "atelier"
  ],
  "homepage": "https://github.com/blackpig/atelier",
  "license": "MIT",
  "authors": [
    {
      "name": "Stuart Hallewell",
      "email": "stuart@blackpig.eu",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3|^8.4",
    "blackpig-creatif/chambre-noir": "^2.0",
    "blackpig-creatif/grimoire": "^2.0",
    "filament/filament": "^5.0",
    "illuminate/contracts": "^12.0|^13.0",
    "spatie/laravel-package-tools": "^1.16"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "BlackpigCreatif\\Atelier\\": "src/",
      "BlackpigCreatif\\Atelier\\Database\\Factories\\": "database/factories/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BlackpigCreatif\\Atelier\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "test-coverage": "vendor/bin/pest --coverage"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
          "pestphp/pest-plugin": true
      }
  },
  "extra": {
    "laravel": {
      "providers": [
        "BlackpigCreatif\\Atelier\\AtelierServiceProvider"
      ],
      "aliases": {
        "Atelier": "BlackpigCreatif\\Atelier\\Facades\\Atelier"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
